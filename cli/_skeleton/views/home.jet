{{extends "./layouts/base.jet"}}

{{block browserTitle()}}Welcome{{end}}

{{block css()}}

{{end}}

{{block pageContent()}}
<div class="col text-center">
  <div class="d-flex align-items-center justify-content-center mt-5">
    <div>
      <img src="/public/images/regius.png" class="mb-1" style="width: 100px;height:auto;">
      <h1>Regius</h1>
      <hr>
      <small class="text-muted">Go build something real</small>
    </div>
  </div>
</div>
{{if .Data.SSEDemo}}
<div class="card mt-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="card-title mb-0">Live Demo</h5>
      <span id="sse-status" class="badge bg-secondary">connecting</span>
    </div>
    <button id="sse-ping" class="btn btn-primary mb-3">Send ping</button>
    <ul id="sse-log" class="list-group" style="height: 142px; overflow-y: auto;"></ul>
  </div>
</div>
{{end}}
{{end}}

{{block js()}}
{{if .Data.SSEDemo}}
<script src="/public/js/sse-demo.js"></script>
{{end}}
{{end}}
