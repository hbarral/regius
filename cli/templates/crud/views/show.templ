package $TABLE

import "${APP_NAME}/views/layouts"

templ Show() {
	@layouts.BaseLayout() {
		<div class="container mx-auto px-4 py-8">
			<h1 class="mb-6 text-3xl font-bold tracking-tight">$TITLE</h1>
			<!-- TODO: render the record passed as Data["item"] -->
			<a href="/$TABLE" class="text-sm font-medium text-primary hover:underline">Back to $TITLEs</a>
		</div>
	}
}
