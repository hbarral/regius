package $TABLE

import (
	"github.com/hbarral/regius/render"

	"${APP_NAME}/views/layouts"
)

templ Form() {
	@layouts.BaseLayout() {
		{{ td, _ := ctx.Value("templateData").(*render.TemplateData) }}
		{{ action := "/$TABLE" }}
		if a, ok := td.Data["formAction"].(string); ok {
			{{ action = a }}
		}
		<div class="container mx-auto px-4 py-8">
			<h1 class="mb-6 text-3xl font-bold tracking-tight">$TITLE form</h1>
			<form method="post" action={ action } class="max-w-md space-y-4">
				<input type="hidden" name="csrf_token" value={ td.CSRFToken }/>
				<!-- TODO: add the $TITLE fields -->
				<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground">
					Save
				</button>
			</form>
		</div>
	}
}
