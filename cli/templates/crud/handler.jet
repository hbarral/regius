// $TITLEEdit renders the edit form for one $TABLE record.
func (h *Handlers) $TITLEEdit(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.Atoi(chi.URLParam(r, "id"))
	if err != nil {
		h.App.ErrorStatus(w, http.StatusBadRequest)
		return
	}
	_ = id

	// TODO: fetch the record, e.g.:
	// one, err := h.Models.$TITLE.Get(id)
	// if err != nil {
	// 	h.App.ErrorStatus(w, http.StatusNotFound)
	// 	return
	// }

	err = h.App.Render.Page(w, r, h.App.Render.Jet("$TABLE/form", nil), &render.TemplateData{Data: map[string]any{
		"id":         id,
		"formAction": "/$TABLE/" + chi.URLParam(r, "id"),
		// "item": one,
	}})
	if err != nil {
		h.App.ErrorLog.Println("error rendering", err)
	}
}

