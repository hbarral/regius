{{extends "./layouts/main.jet"}}

{{block browserTitle()}}$HANDLER_NAME{{end}}

{{block css()}}{{end}}

{{block pageContent()}}
<main class="flex-1">
  <div class="flex h-full items-center justify-center">
    <div class="flex w-full max-w-2xl flex-col items-center justify-center gap-4 px-4">
      <div class="w-full max-w-sm rounded-xl border bg-card text-card-foreground shadow p-6">
        <h1 class="text-2xl font-semibold leading-none tracking-tight">$HANDLER_NAME</h1>
        <p class="mt-2 text-sm text-muted-foreground">$HANDLER_NAME page rendered with the jet renderer.</p>
      </div>
    </div>
  </div>
</main>
{{end}}

{{block js()}}{{end}}
