<div
  x-show="open"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="translate-x-full"
  class="fixed inset-y-0 right-0 z-50 h-full w-3/4 border-l bg-background p-6 shadow-lg sm:max-w-sm"
  @click.away="open = false"
  style="display: none;"
>
  <div class="flex flex-col h-full">
    <div class="flex items-center justify-between pb-4 border-b">
      <h2 class="text-lg font-semibold">Menu</h2>
      <button
        type="button"
        aria-label="Close menu"
        @click="open = false"
        class="inline-flex size-10 items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
    <div class="flex flex-col gap-1 py-4">
      <a href="/" @click="open = false" class="inline-flex items-center justify-start whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 w-full text-foreground select-none">
        Home
      </a>
      <a href="https://regius.pro/docs/intro" target="_blank" @click="open = false" class="inline-flex items-center justify-start whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 w-full text-foreground select-none">
        Docs
      </a>
      <a href="https://github.com/hbarral/regius" target="_blank" @click="open = false" class="inline-flex items-center justify-start whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 w-full text-foreground select-none">
        Github
      </a>
    </div>
    <div class="mt-auto flex flex-col gap-2 pt-4 border-t">
      {{if .IsAuthenticated}}
      <span class="px-4 py-2 text-sm font-medium text-foreground">
        Welcome, {{.Data["userName"]}}
      </span>
      <form method="post" action="/auth/signout" class="inline">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button type="submit" @click="open = false" class="inline-flex items-center justify-start whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 w-full text-foreground">
          Sign Out
        </button>
      </form>
      {{else}}
      <a href="/auth/signin" @click="open = false" class="inline-flex items-center justify-start whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2 w-full text-foreground select-none">
        Sign In
      </a>
      <a href="https://regius.pro/docs/usage" target="_blank" @click="open = false" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4 py-2 shadow-lg select-none w-full">
        Get Started
      </a>
      {{end}}
    </div>
  </div>
</div>
