package views

import (
	"github.com/hbarral/regius/i18n"
	"github.com/templui/templui/components/separator"
	"${APP_NAME}/views/layouts"
)

templ Home() {
	@layouts.BaseLayout() {
		<div class="flex h-full items-center justify-center">
			<div class="flex flex-col items-center gap-6 text-center [&>small]:text-primary">
				<img src="/public/images/regius.png" alt={ i18n.T(ctx, "app.name") } class="h-auto w-24 select-none"/>
				<h1 class="text-4xl font-bold tracking-tight select-none">
					{ i18n.T(ctx, "home.title") }
				</h1>
				@separator.Separator(separator.Props{
					Class: "w-48",
				})
				<small class="text-muted-foreground select-none">
					{ i18n.T(ctx, "home.subtitle") }
				</small>
			</div>
		</div>
	}
}
