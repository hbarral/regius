package views

import (
	"github.com/hbarral/regius/i18n"
	"github.com/hbarral/regius/render"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/checkbox"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	"${APP_NAME}/views/components"
	"${APP_NAME}/views/layouts"
)

templ SignIn() {
	@layouts.MainLayout() {
		{{ td, _ := ctx.Value("templateData").(*render.TemplateData) }}
		<main class="flex-1">
			<div class="flex h-full items-center justify-center">
				<div class="flex w-full max-w-2xl flex-col items-center justify-center gap-4 px-4">
					<div class="w-full max-w-sm">
						@card.Card() {
							@card.Header() {
								@card.Title() {
									{ i18n.T(ctx, "auth.sign_in_title") }
								}
								@card.Description() {
									{ i18n.T(ctx, "auth.sign_in_description") }
								}
							}
							@card.Content() {
								if td.Error != "" {
									<div class="mb-4 rounded-md bg-destructive/10 p-3 text-center text-sm text-destructive dark:bg-destructive/20">
										{ td.Error }
									</div>
								}
								if td.Flash != "" {
									<div class="mb-4 rounded-md bg-blue-50 p-3 text-center text-sm text-blue-800 dark:bg-blue-950 dark:text-blue-200">
										{ td.Flash }
									</div>
								}
								<div class="flex flex-col gap-4">
									<form method="post" action="/auth/signin" name="signin-form" id="signin-form" autocomplete="off">
										<input type="hidden" name="csrf_token" value={ td.CSRFToken }/>
										<div class="flex flex-col gap-4">
											<div class="w-full max-w-sm grid gap-2">
												@label.Label(label.Props{
													For: "email",
												}) {
													{ i18n.T(ctx, "auth.email") }
												}
												@input.Input(input.Props{
													ID:          "email",
													Name:        "email",
													Type:        input.TypeEmail,
													Placeholder: "username@example.com",
													Required:    true,
												})
											</div>
											<div class="w-full max-w-sm grid gap-2">
												<div class="flex items-center justify-between">
													@label.Label(label.Props{
														For: "password",
													}) {
														{ i18n.T(ctx, "auth.password") }
													}
													<a href="/auth/forgot-password" class="ml-auto text-sm underline-offset-4 hover:underline">
														{ i18n.T(ctx, "auth.forgot_password") }
													</a>
												</div>
												@input.Input(input.Props{
													ID:          "password",
													Name:        "password",
													Type:        input.TypePassword,
													Placeholder: "password",
													Required:    true,
												})
											</div>
											<div class="flex items-center gap-2">
												@checkbox.Checkbox(checkbox.Props{
													ID:    "remember",
													Name:  "remember",
													Value: "remember",
												})
												@label.Label(label.Props{
													For: "remember",
												}) {
													{ i18n.T(ctx, "auth.remember_me") }
												}
											</div>
										</div>
									</form>
									@components.SocialLoginButtons()
								</div>
							}
							@card.Footer(card.FooterProps{
								Class: "flex flex-col gap-2",
							}) {
								@button.Button(button.Props{
									Type:  button.TypeSubmit,
									Form:  "signin-form",
									Class: "w-full",
								}) {
									{ i18n.T(ctx, "auth.sign_in_button") }
								}
								<div class="flex">
									@card.Description(card.DescriptionProps{
										Class: "text-sm leading-normal font-normal text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary text-center",
									}) {
										{ i18n.T(ctx, "auth.no_account") }
										<a href="/auth/signup" class="text-sm underline underline-offset-4">
											{ i18n.T(ctx, "auth.sign_up_link") }
										</a>
									}
								</div>
							}
						}
					</div>
				</div>
			</div>
		</main>
		@input.Script()
	}
}
