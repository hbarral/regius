# Production multi-stage build for a Regius app (jet renderer).
#
# The jet renderer ships plain .jet views, so only the Tailwind stylesheet
# needs building — no templ compilation step.

# ---- builder ----
FROM golang:1.25-alpine AS builder
WORKDIR /src
RUN apk add --no-cache nodejs npm gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Tailwind sources (assets/css/sources.generated.css) were written at scaffold
# time and use relative @source paths, so the stylesheet builds directly.
RUN npx --yes @tailwindcss/cli -i assets/css/input.css -o public/css/output.css

# CGO is required: the framework uses mattn/go-sqlite3 for sqlite.
RUN CGO_ENABLED=1 go build -ldflags "-s -w" -o /out/app .

# ---- runtime ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
RUN adduser -D -u 10001 regius
WORKDIR /app
COPY --from=builder /out/app ./app
COPY --from=builder /src/public ./public
COPY --from=builder /src/migrations ./migrations
USER regius
EXPOSE 4000
ENTRYPOINT ["./app"]
