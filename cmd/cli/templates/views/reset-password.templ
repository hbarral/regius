package views

import (
	"github.com/hbarral/regius/render"
	"github.com/templui/templui/components/button"
	"github.com/templui/templui/components/card"
	"github.com/templui/templui/components/input"
	"github.com/templui/templui/components/label"
	"${APP_NAME}/views/layouts"
)

templ ResetPassword() {
	@layouts.MainLayout() {
		{{ td, _ := ctx.Value("templateData").(*render.TemplateData) }}
		{{ email, _ := td.Data["Email"].(string) }}
		<main class="flex-1">
			<div class="flex h-full items-center justify-center">
				<div class="flex w-full max-w-2xl flex-col items-center justify-center gap-4 px-4">
					<div class="w-full max-w-sm">
						@card.Card() {
							@card.Header() {
								@card.Title() {
									Reset your password
								}
								@card.Description() {
									Enter and confirm your new password
								}
							}
							@card.Content() {
								if td.Error != "" {
									<div class="mb-4 rounded-md bg-destructive/10 p-3 text-center text-sm text-destructive dark:bg-destructive/20">
										{ td.Error }
									</div>
								}
								if td.Flash != "" {
									<div class="mb-4 rounded-md bg-blue-50 p-3 text-center text-sm text-blue-800 dark:bg-blue-950 dark:text-blue-200">
										{ td.Flash }
									</div>
								}
								<div class="flex flex-col gap-4">
									<form method="post" action="/auth/reset-password" name="reset-form" id="reset-form" autocomplete="off">
										<input type="hidden" name="csrf_token" value={ td.CSRFToken }/>
										<input type="hidden" name="email" value={ email }/>
										<div class="flex flex-col gap-4">
											<div class="w-full max-w-sm grid gap-2">
												@label.Label(label.Props{
													For: "password",
												}) {
													Password
												}
												@input.Input(input.Props{
													ID:       "password",
													Name:     "password",
													Type:     input.TypePassword,
													Required: true,
												})
											</div>
											<div class="w-full max-w-sm grid gap-2">
												@label.Label(label.Props{
													For: "verify-password",
												}) {
													Verify Password
												}
												@input.Input(input.Props{
													ID:       "verify-password",
													Name:     "verify-password",
													Type:     input.TypePassword,
													Required: true,
												})
											</div>
										</div>
									</form>
								</div>
							}
							@card.Footer(card.FooterProps{
								Class: "flex flex-col gap-2",
							}) {
								@button.Button(button.Props{
									Type:  button.TypeSubmit,
									Form:  "reset-form",
									Class: "w-full",
								}) {
									Reset password
								}
								<div class="flex">
									@card.Description(card.DescriptionProps{
										Class: "text-sm leading-normal font-normal text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary text-center",
									}) {
										<a href="/" class="text-sm underline underline-offset-4">
											Back
										</a>
									}
								</div>
							}
						}
					</div>
				</div>
			</div>
		</main>
		@input.Script()
		<script>
			document.getElementById("reset-form").addEventListener("submit", function (e) {
				var p = document.getElementById("password").value;
				var v = document.getElementById("verify-password").value;
				if (p !== v) {
					e.preventDefault();
					alert("passwords do not match!");
					return;
				}
			});
		</script>
	}
}
